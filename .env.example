# Copy this file to ".env" and fill in your Supabase project values.
# Find them in your Supabase dashboard under: Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The single coach's login email. This account gets the full builder;
# everyone else who logs in gets the client portal.
# Must match coach_email() in supabase/migration-clients-auth.sql.
VITE_COACH_EMAIL=you@example.com
